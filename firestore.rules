rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/reminders/{reminderId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'title',
          'notes',
          'dueAt',
          'timeZone',
          'sourceTranscript',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'title',
          'notes',
          'dueAt',
          'timeZone',
          'sourceTranscript',
          'status',
          'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.dueAt is timestamp
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() <= 100
        && request.resource.data.sourceTranscript is string
        && request.resource.data.sourceTranscript.size() <= 5000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'done'];
      allow delete: if isOwner();
    }
  }
}
